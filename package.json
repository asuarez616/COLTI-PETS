{
  "name": "colti-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:drive": "node scripts/sync-drive-catalog.mjs",
    "test:drive": "node --test scripts/drive-catalog.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "admin:server": "node scripts/serve-admin.mjs",
    "test:drive-oauth": "node --test scripts/drive-oauth.test.mjs",
    "admin:preview": "vite --mode admin-preview --host 127.0.0.1 --port 4174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "seed:assets": "node scripts/upload-catalog.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:sql": "node scripts/test-sql-local.mjs",
    "test:visual": "playwright test tests/phase-22.spec.ts tests/layout-stability.spec.ts",
    "sync:hero": "node scripts/sync-drive-catalog.mjs --hero"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "2.57.4",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "axe-core": "4.10.3",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
